@page
@model ProGestao.Pages.Grid.IndexModel
@{
    ViewData["Title"] = "Grid Semanal";
    ViewData["PageDescription"] = "Visualização em grid das atividades por semana";
}

@* CSS específico da página *@
@section Styles {
    <link rel="stylesheet" href="~/css/components/dropdown-fix.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/grid.css" asp-append-version="true">
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header">
                <h2 class="page-title">
                    <i class="fas fa-calendar-alt text-primary me-2"></i>
                    Grid Semanal
                </h2>
                <p class="page-subtitle text-muted">
                    Visualização das atividades da equipe organizadas por semana
                </p>
            </div>
        </div>
    </div>

    <!-- Controls Row -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="grid-controls d-flex justify-content-between align-items-center flex-wrap gap-3">
                
                <!-- Week Navigation -->
                <div class="week-navigation">
                    <div class="btn-group" role="group" aria-label="Navegação de semanas">
                        <a href="@Url.Page("./Index", new { semana = Model.SemanaAnterior })" 
                           class="btn btn-outline-primary">
                            <i class="fas fa-chevron-left me-1"></i>
                            Anterior
                        </a>
                        <button type="button" class="btn btn-primary position-relative">
                            Semana Atual
                            @if (Model.TemAtividadesAtrasadas)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @Model.QtdAtividadesAtrasadas
                                    <span class="visually-hidden">atividades atrasadas</span>
                                </span>
                            }
                        </button>
                        <a href="@Url.Page("./Index", new { semana = Model.ProximaSemana })" 
                           class="btn btn-outline-primary">
                            Próxima
                            <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    </div>
                </div>

                <!-- Period Dropdown -->
                <div class="period-controls d-flex align-items-center gap-2">
                    <!-- Filtros adicionais -->
                    <select class="form-select form-select-sm" style="width: auto;" 
                            name="equipeId" onchange="this.form.submit()">
                        <option value="">Todas as equipes</option>
                        @foreach (var equipe in Model.Equipes)
                        {
                            <option value="@equipe.Id" selected="@(Model.FiltroEquipeId == equipe.Id)">
                                @equipe.Nome
                            </option>
                        }
                    </select>

                    <!-- Dropdown de Período -->
                    <div class="dropdown dropdown-period-container" 
                         data-dropdown-auto 
                         data-dropdown-id="period-dropdown">
                        
                        <button class="btn dropdown-period-toggle dropdown-toggle" 
                                type="button" 
                                id="dropdownPeriodo" 
                                data-bs-toggle="dropdown" 
                                aria-expanded="false"
                                aria-haspopup="true"
                                aria-label="Selecionar período de visualização">
                            <i class="fas fa-calendar me-2"></i>
                            <span id="period-label">@Model.PeriodoSelecionado</span>
                        </button>
                        
                        <ul class="dropdown-menu" aria-labelledby="dropdownPeriodo">
                            @foreach (var periodo in Model.PeriodosDisponiveis)
                            {
                                <li>
                                    <button class="dropdown-period-item @(periodo.Valor == Model.PeriodoAtual ? "active" : "")" 
                                            type="button"
                                            data-period-value="@periodo.Valor"
                                            data-period-label="@periodo.Nome">
                                        <i class="@periodo.Icone me-2"></i>
                                        @periodo.Nome
                                        @if (periodo.Descricao != null)
                                        {
                                            <small class="text-muted d-block">@periodo.Descricao</small>
                                        }
                                    </button>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <button class="dropdown-period-item" 
                                        type="button"
                                        data-bs-toggle="modal" 
                                        data-bs-target="#customPeriodModal">
                                    <i class="fas fa-cog me-2"></i>
                                    Período customizado
                                </button>
                            </li>
                        </ul>
                    </div>

                    <!-- Refresh Button -->
                    <button type="button" 
                            class="btn btn-outline-secondary" 
                            onclick="location.reload()"
                            title="Atualizar dados">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid Container -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm grid-container">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-th-large me-2"></i>
                            @Model.TituloSemana
                        </h5>
                        <div class="grid-stats">
                            <span class="badge bg-primary me-2">
                                @Model.TotalAtividades atividades
                            </span>
                            @if (Model.TemAtividadesAtrasadas)
                            {
                                <span class="badge bg-danger">
                                    @Model.QtdAtividadesAtrasadas atrasadas
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <!-- Grid responsivo -->
                    <div class="table-responsive grid-wrapper">
                        <table class="table table-bordered table-hover mb-0 week-grid">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th scope="col" class="user-column">
                                        <i class="fas fa-user me-1"></i>
                                        Desenvolvedor
                                    </th>
                                    @foreach (var dia in Model.DiasSemana)
                                    {
                                        <th scope="col" class="day-column text-center">
                                            <div class="day-header">
                                                <div class="day-name">@dia.DiaSemana</div>
                                                <div class="day-number">@dia.Dia</div>
                                                <small class="text-muted">@dia.Mes</small>
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usuario in Model.UsuariosGrid)
                                {
                                    <tr>
                                        <td class="user-cell">
                                            <div class="user-info">
                                                <div class="user-avatar">
                                                    @usuario.Iniciais
                                                </div>
                                                <div class="user-details">
                                                    <div class="user-name">@usuario.Nome</div>
                                                    <small class="text-muted">@usuario.Cargo</small>
                                                </div>
                                            </div>
                                        </td>
                                        @foreach (var dia in Model.DiasSemana)
                                        {
                                            <td class="activity-cell">
                                                @{
                                                    var atividades = usuario.AtividadesPorDia
                                                        .Where(a => a.Data.Date == dia.Data.Date);
                                                }
                                                @if (atividades.Any())
                                                {
                                                    <div class="activities-container">
                                                        @foreach (var atividade in atividades)
                                                        {
                                                            <div class="activity-item @GetActivityCssClass(atividade)"
                                                                 data-bs-toggle="tooltip"
                                                                 title="@atividade.Descricao">
                                                                <div class="activity-content">
                                                                    <div class="activity-title">@atividade.Nome</div>
                                                                    <div class="activity-meta">
                                                                        <span class="activity-status">
                                                                            @atividade.Status.Nome
                                                                        </span>
                                                                        @if (atividade.Prioridade > 2)
                                                                        {
                                                                            <i class="fas fa-exclamation-triangle text-warning ms-1"></i>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="no-activities">
                                                        <i class="fas fa-minus text-muted"></i>
                                                    </div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (!Model.UsuariosGrid.Any())
                {
                    <div class="card-body text-center py-5">
                        <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Nenhuma atividade encontrada</h5>
                        <p class="text-muted">
                            Não há atividades cadastradas para o período selecionado.
                        </p>
                        <a href="@Url.Page("/Atividades/Create")" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i>
                            Criar Nova Atividade
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Legend -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="fas fa-info-circle me-1"></i>
                        Legenda
                    </h6>
                    <div class="legend-items d-flex flex-wrap gap-3">
                        @foreach (var status in Model.StatusAtividades)
                        {
                            <div class="legend-item d-flex align-items-center">
                                <div class="legend-color" 
                                     style="background-color: @status.Cor; width: 16px; height: 16px; border-radius: 2px;"></div>
                                <span class="ms-2">@status.Nome</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para período customizado -->
<div class="modal fade" id="customPeriodModal" tabindex="-1" aria-labelledby="customPeriodModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CustomPeriod">
                <div class="modal-header">
                    <h5 class="modal-title" id="customPeriodModalLabel">
                        <i class="fas fa-calendar-alt me-2"></i>
                        Período Customizado
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label for="dataInicio" class="form-label">Data Início</label>
                            <input type="date" class="form-control" id="dataInicio" name="dataInicio" required>
                        </div>
                        <div class="col-md-6">
                            <label for="dataFim" class="form-label">Data Fim</label>
                            <input type="date" class="form-control" id="dataFim" name="dataFim" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check me-1"></i>
                        Aplicar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* JavaScript específico da página *@
@section Scripts {
    <script src="~/js/services/DropdownService.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Inicializa tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Configura dropdown de período
            setupPeriodDropdown();

            // Auto-refresh (opcional)
            @if (Model.AutoRefresh)
            {
                <text>
                setInterval(function() {
                    location.reload();
                }, @Model.AutoRefreshInterval);
                </text>
            }
        });

        function setupPeriodDropdown() {
            // Registra o dropdown no serviço
            const dropdown = window.ProGestao.DropdownService.register(
                'period-dropdown',
                document.querySelector('[data-dropdown-id="period-dropdown"]'),
                {
                    debug: @Json.Serialize(Model.IsDebugMode)
                }
            );

            // Observer para mudanças de período
            window.ProGestao.DropdownService.addObserver(function(event, data) {
                if (event === 'itemClick' && data.id === 'period-dropdown') {
                    handlePeriodChange(data.item);
                }
            });
        }

        function handlePeriodChange(item) {
            const periodValue = item.getAttribute('data-period-value');
            const periodLabel = item.getAttribute('data-period-label');
            
            if (periodValue) {
                // Atualiza o label do botão
                document.getElementById('period-label').textContent = periodLabel;
                
                // Redireciona com o novo período
                const url = new URL(window.location);
                url.searchParams.set('periodo', periodValue);
                window.location.href = url.toString();
            }
        }

        // Função auxiliar para debug
        @if (Model.IsDebugMode)
        {
            <text>
            window.debugGrid = {
                toggleDropdownDebug: function() {
                    document.body.classList.toggle('debug-zindex');
                },
                getDropdownInfo: function() {
                    return window.ProGestao.DropdownService.dropdowns.get('period-dropdown');
                }
            };
            console.log('Grid Debug mode enabled. Use window.debugGrid for debugging.');
            </text>
        }
    </script>
}

@functions {
    private string GetActivityCssClass(AtividadeGridViewModel atividade)
    {
        var classes = new List<string> { "activity-item" };
        
        // Status
        classes.Add($"status-{atividade.Status.Nome.ToLower().Replace(" ", "-")}");
        
        // Prioridade
        if (atividade.Prioridade >= 3)
            classes.Add("high-priority");
        
        // Atraso
        if (atividade.EstaAtrasada)
            classes.Add("overdue");
            
        return string.Join(" ", classes);
    }
}