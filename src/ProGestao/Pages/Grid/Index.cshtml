@page
@using ProGestao.ViewModels.Atividade
@model ProGestao.Pages.Grid.IndexModel
@{
    ViewData["Title"] = "Grid Semanal";
    ViewData["PageDescription"] = "Visualização em grid das atividades por semana";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/grid.css" asp-append-version="true">
   
    
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="header-blue">
        <div class="container">
            <h2 class="mb-0">
                <i class="fas fa-calendar-alt me-2"></i>
                Grid Semanal
            </h2>
            <p class="page-subtitle">
                Visualização das atividades da equipe organizadas por período
            </p>
        </div>
    </div>

    <!-- Controls Row -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="grid-controls d-flex justify-content-between align-items-center flex-wrap gap-3" id="grid-controls">
                
                <!-- Navegação de Período -->
                <div class="week-navigation">
                    <div class="btn-group" role="group" aria-label="Navegação de períodos">
                        <a href="@Url.Page("./Index", new { semana = Model.SemanaAnterior, periodo = Model.Periodo, equipeId = Model.EquipeId })"
                           class="btn btn-outline-primary">
                            <i class="fas fa-chevron-left me-1"></i>
                            Anterior
                        </a>
                        <button type="button" class="btn btn-primary position-relative">
                            @Model.TituloSemana
                            @if (Model.TemAtividadesAtrasadas)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @Model.QtdAtividadesAtrasadas
                                    <span class="visually-hidden">atividades atrasadas</span>
                                </span>
                            }
                        </button>
                        <a href="@Url.Page("./Index", new { semana = Model.ProximaSemana, periodo = Model.Periodo, equipeId = Model.EquipeId })"
                           class="btn btn-outline-primary">
                            Próximo
                            <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    </div>
                </div>

                <!-- Controles de Período e Filtros -->
                <div class="period-controls">
                    <form method="get" class="d-flex align-items-center gap-3 flex-wrap">
                        <!-- Seletor de Período (maior e primeiro) -->
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false" 
                                    style="min-width: 200px;" id="dropdownPeriodo">
                                <i class="fas fa-calendar me-1"></i>
                                @{
                                    var periodoAtual = Model.PeriodosDisponiveis?.FirstOrDefault(p => p.Valor == Model.Periodo);
                                    var nomePeriodo = periodoAtual?.Nome ?? "Esta Semana";
                                }
                                @nomePeriodo
                            </button>
                            <ul class="dropdown-menu dropdown-menu-custom" style="min-width: 250px;">
                                @if (Model.PeriodosDisponiveis != null)
                                {
                                    @foreach (var periodo in Model.PeriodosDisponiveis)
                                    {
                                        <li>
                                            <a class="dropdown-item @(periodo.Valor == Model.Periodo ? "active" : "")" 
                                               href="@Url.Page("./Index", new { periodo = periodo.Valor, equipeId = Model.EquipeId })">
                                                <i class="@periodo.Icone me-2"></i>
                                                @periodo.Nome
                                                <small class="text-muted ms-2">(@periodo.Descricao)</small>
                                            </a>
                                        </li>
                                    }
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#customPeriodModal">
                                        <i class="fas fa-cog me-2"></i>
                                        Período Customizado
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <!-- Filtro de Equipe (maior) -->
                        <div class="form-group mb-0">
                            <select name="equipeId" class="form-select" onchange="this.form.submit()" style="min-width: 220px;">
                                <option value="">📄 Todas as equipes</option>
                                @if (Model.Equipes != null)
                                {
                                    @foreach (var equipe in Model.Equipes)
                                    {
                                        <option value="@equipe.Id" selected="@(Model.EquipeId == equipe.Id)">
                                            👥 @equipe.Nome
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <input type="hidden" name="periodo" value="@Model.Periodo" />
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid Card -->
    <div class="row">
        <div class="col-12">
            <div class="grid-container card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-th-large me-2"></i>
                            @Model.TituloSemana
                        </h5>
                        <div class="grid-stats">
                            <span class="badge bg-primary me-2" >
                                @Model.TotalAtividades atividades
                            </span>
                            @if (Model.TemAtividadesAtrasadas)
                            {
                                <span class="badge bg-danger">
                                    @Model.QtdAtividadesAtrasadas atrasadas
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <!-- Grid responsivo -->
                    <div class="table-responsive grid-wrapper">
                        <table class="table table-bordered table-hover mb-0 week-grid">
                            <!-- Cabeçalho da tabela -->
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th scope="col" class="user-column">
                                        <i class="fas fa-user me-1"></i>
                                        Desenvolvedor
                                    </th>
                                    @if (Model.DiasSemana != null)
                                    {
                                        @foreach (var dia in Model.DiasSemana)
                                        {
                                            <th scope="col" class="day-column text-center @(dia.EhHoje ? "today" : "") @(dia.EhFimDeSemana ? "weekend" : "")">
                                                <div class="day-header">
                                                    <div class="day-name">@(dia.DiaSemana?.Length > 3 ? dia.DiaSemana.Substring(0, 3) : dia.DiaSemana)</div>
                                                    <div class="day-number">@dia.Dia</div>
                                                    <small class="text-muted">@dia.Mes</small>
                                                </div>
                                            </th>
                                        }
                                    }
                                </tr>
                            </thead>

                            <!-- Corpo da tabela -->
                            <tbody>
                                @if (Model.UsuariosGrid == null || !Model.UsuariosGrid.Any())
                                {
                                    <tr>
                                        <td colspan="@((Model.DiasSemana?.Count ?? 0) + 1)" class="text-center p-4">
                                            <div class="empty-state">
                                                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                                                <h5 class="text-muted">Nenhum usuário encontrado</h5>
                                                <p class="text-muted mb-0">
                                                    @if (Model.EquipeId.HasValue)
                                                    {
                                                        <text>Tente selecionar uma equipe diferente ou "Todas as equipes".</text>
                                                    }
                                                    else
                                                    {
                                                        <text>Verifique se existem usuários cadastrados no sistema.</text>
                                                    }
                                                </p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var usuario in Model.UsuariosGrid)
                                    {
                                        <tr>
                                            <!-- Coluna do usuário -->
                                            <td class="user-cell user-column">
                                                <div class="user-info">
                                                    <div class="user-avatar">
                                                        @usuario.Iniciais
                                                    </div>
                                                    <div class="user-details">
                                                        <div class="user-name">@usuario.Nome</div>
                                                        <small class="text-muted">@usuario.Cargo</small>
                                                        @if (usuario.TotalAtividades > 0)
                                                        {
                                                            <div class="user-stats mt-1">
                                                                <small class="badge bg-primary">
                                                                    @usuario.TotalAtividades atividades
                                                                </small>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- Colunas dos dias -->
                                            @if (Model.DiasSemana != null)
                                            {
                                                @foreach (var dia in Model.DiasSemana)
                                                {
                                                    <td class="activity-cell @(dia.EhHoje ? "today" : "") @(dia.EhFimDeSemana ? "weekend" : "")">
                                                        @{
                                                            var dataKey = dia.Data.Date;
                                                            var atividades = usuario.AtividadesPorDia?.ContainsKey(dataKey) == true 
                                                                ? usuario.AtividadesPorDia[dataKey] 
                                                                : new List<AtividadeGridViewModel>();
                                                        }
                                                        
                                                        @if (atividades != null && atividades.Any())
                                                        {
                                                            <div class="activities-container">
                                                                @foreach (var atividade in atividades)
                                                                {
                                                                    <a href="@Url.Page("/Atividades/Details", new { id = atividade.Id })"
                                                                       class="activity-link"
                                                                       data-bs-toggle="tooltip"
                                                                       data-bs-placement="top"
                                                                       title="📝 @atividade.Nome @(!string.IsNullOrEmpty(atividade.ProjetoNome) ? $" | 📁 {atividade.ProjetoNome}" : "") | 📊 @atividade.StatusNome | ⚡ @atividade.PrioridadeTexto">
                                                                        
                                                                        <div class="activity-item status-@atividade.StatusClasse @(atividade.EstaAtrasada ? "overdue" : "") @(atividade.Prioridade >= 3 ? "high-priority" : "")"
                                                                             style="border-left: 4px solid @(atividade.StatusCor ?? "#6c757d");">
                                                                            
                                                                            <div class="activity-content">
                                                                                <!-- Título - TEXTO TRUNCADO -->
                                                                                <div class="activity-title" title="@atividade.Nome">
                                                                                    @{
                                                                                        var tituloTruncado = atividade.Nome.Length > 10 
                                                                                            ? atividade.Nome.Substring(0, 10) + "..." 
                                                                                            : atividade.Nome;
                                                                                    }
                                                                                    @tituloTruncado
                                                                                    @if (atividade.Prioridade >= 3)
                                                                                    {
                                                                                        <i class="fas fa-exclamation-triangle text-warning ms-1"
                                                                                           title="Prioridade @atividade.PrioridadeTexto"></i>
                                                                                    }
                                                                                </div>

                                                                                <!-- Status -->
                                                                                <div class="activity-meta">
                                                                                    <span class="activity-status"
                                                                                          style="background-color: @(atividade.StatusCor ?? "#6c757d");">
                                                                                        @atividade.StatusNome
                                                                                    </span>
                                                                                </div>

                                                                                <!-- Projeto se existir - TEXTO TRUNCADO -->
                                                                                @if (!string.IsNullOrEmpty(atividade.ProjetoNome))
                                                                                {
                                                                                    <div class="activity-project" title="@atividade.ProjetoNome">
                                                                                        @{
                                                                                            var projetoTruncado = atividade.ProjetoNome.Length > 30 
                                                                                                ? atividade.ProjetoNome.Substring(0, 30) + "..." 
                                                                                                : atividade.ProjetoNome;
                                                                                        }
                                                                                        <i class="fas fa-folder-open me-1"></i>
                                                                                        @projetoTruncado
                                                                                    </div>
                                                                                }

                                                                                <!-- Preview de informações -->
                                                                                @if (atividade.DataFimPrevista.HasValue)
                                                                                {
                                                                                    <div class="activity-preview">
                                                                                        <i class="fas fa-clock me-1"></i>
                                                                                        @atividade.DataFimPrevista.Value.ToString("dd/MM")
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    </a>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="empty-day">
                                                                <i class="fas fa-calendar-times opacity-50"></i>
                                                            </div>
                                                        }
                                                    </td>
                                                }
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Período Customizado -->
<div class="modal fade" id="customPeriodModal" tabindex="-1" aria-labelledby="customPeriodModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="PeriodoCustomizado">
                <div class="modal-header">
                    <h5 class="modal-title" id="customPeriodModalLabel">
                        <i class="fas fa-calendar-alt me-2"></i>
                        Período Customizado
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label for="dataInicio" class="form-label">Data Inicial</label>
                            <input type="date" class="form-control" id="dataInicio" name="dataInicio" required
                                   value="@Model.PeriodoInicio.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-6">
                            <label for="dataFim" class="form-label">Data Final</label>
                            <input type="date" class="form-control" id="dataFim" name="dataFim" required
                                   value="@Model.PeriodoFim.ToString("yyyy-MM-dd")">
                        </div>
                    </div>
                    <input type="hidden" name="equipeId" value="@Model.EquipeId" />
                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Período máximo de 30 dias
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check me-1"></i>
                        Aplicar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Força o scroll para o topo ao carregar a página
        window.scrollTo(0, 0);
        
        document.addEventListener('DOMContentLoaded', function() {
            // Garante que o foco fique no topo
            window.scrollTo(0, 0);
                    document.querySelectorAll('[autofocus]').forEach(el => {
                el.removeAttribute('autofocus');
                el.blur();
            });
                // Remove âncoras da URL
            if (window.location.hash) {
                history.replaceState(null, null, window.location.pathname + window.location.search);
            }

            // Mantém foco no topo da página
            setTimeout(() => window.scrollTo(0, 0), 100);

            // Inicializa tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl, {
                    html: true,
                    sanitize: false
                });
            });

            // Correção FORÇADA do posicionamento do dropdown
            const dropdownButton = document.getElementById('dropdownPeriodo');
            const dropdownMenu = document.querySelector('.dropdown-menu-custom');
            
            if (dropdownButton && dropdownMenu) {
                 const dropdown = new bootstrap.Dropdown(dropdownButton, {
                    autoClose: true,
                    boundary: 'viewport',
                    offset: [0, 2],
                    placement: 'bottom-start'
                });
                // Remove configurações automáticas do Bootstrap que podem interferir
                dropdownMenu.removeAttribute('data-bs-popper');
                dropdownMenu.style.position = 'absolute';
                dropdownMenu.style.inset = 'auto';
                dropdownMenu.style.margin = '0';
                dropdownMenu.style.transform = 'none';
                
                // Força posicionamento correto
                dropdownButton.addEventListener('shown.bs.dropdown', function() {
                    setTimeout(() => {
                        dropdownMenu.style.position = 'absolute';
                        dropdownMenu.style.top = 'calc(100% + 2px)';
                        dropdownMenu.style.left = '0';
                        dropdownMenu.style.transform = 'none';
                        dropdownMenu.style.margin = '0';
                        dropdownMenu.style.inset = 'auto';
                    }, 1);
                });
                
                // Observer para detectar mudanças
                const observer = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        if (mutation.attributeName === 'style' && dropdownMenu.classList.contains('show')) {
                            dropdownMenu.style.transform = 'none';
                            dropdownMenu.style.top = 'calc(100% + 2px)';
                            dropdownMenu.style.left = '0';
                        }
                    });
                });
                
                observer.observe(dropdownMenu, { attributes: true, attributeFilter: ['style'] });


            }

            // Validação do modal de período customizado
            const form = document.querySelector('#customPeriodModal form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    const dataInicio = new Date(document.getElementById('dataInicio').value);
                    const dataFim = new Date(document.getElementById('dataFim').value);
                    
                    if (dataInicio > dataFim) {
                        e.preventDefault();
                        alert('Data inicial não pode ser maior que data final.');
                        return;
                    }
                    
                    const diffTime = Math.abs(dataFim - dataInicio);
                    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                    
                    if (diffDays > 30) {
                        e.preventDefault();
                        alert('Período não pode ser maior que 30 dias.');
                        return;
                    }
                });
            }

            // Removido auto-scroll para coluna 'today' para manter foco no topo

            // Debug para desenvolvimento
            if (window.console && '@(Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT"))' === 'Development') {
                console.log('=== GRID CONSOLIDADO DEBUG ===');
                console.log('Usuários:', @(Model.UsuariosGrid?.Count ?? 0));
                console.log('Atividades totais:', @Model.TotalAtividades);
                console.log('Dias:', @(Model.DiasSemana?.Count ?? 0));
                console.log('Período:', '@Model.Periodo');
                
                // Verificar atividades por usuário
                @if (Model.UsuariosGrid != null)
                {
                    @foreach (var usuario in Model.UsuariosGrid)
                    {
                        <text>
                        console.log('📊 @usuario.Nome: @usuario.TotalAtividades atividades');
                        </text>
                    }
                }
                console.log('================================');
            }
        });

        window.addEventListener("load", function () {
            // Força o scroll para o topo
            window.scrollTo(0, 0);

            // Remove autofocus que pode centralizar o campo
            document.querySelectorAll('[autofocus]').forEach(el => {
                el.removeAttribute('autofocus');
                el.blur();
            });

            // Remove âncoras da URL
            if (window.location.hash) {
                history.replaceState(null, null, window.location.pathname + window.location.search);
            }
        });
    </script>
}

@functions {
    private string GetActivityCssClass(AtividadeGridViewModel atividade)
    {
        var classes = new List<string> { "activity-item" };

        if (atividade?.Prioridade >= 3)
            classes.Add("high-priority");

        if (atividade?.EstaAtrasada == true)
            classes.Add("overdue");

        if (!string.IsNullOrEmpty(atividade?.ProjetoNome))
            classes.Add("has-project");

        return string.Join(" ", classes);
    }
}