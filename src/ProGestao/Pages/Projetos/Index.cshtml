@page
@model ProGestao.Pages.Projetos.IndexModel
@{
    ViewData["Title"] = "Gestão de Projetos";
}

<div class="header-blue">
    <div class="container">
        <h2 class="mb-0">
            <i class="fas fa-project-diagram me-2"></i>Gestão de Projetos
        </h2>
    </div>
</div>

<div class="container">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header card-header-blue">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="mb-0">Filtros de Pesquisa</h5>
                        </div>
                        <div class="col-md-4 text-end">
                            <a href="/Projetos/Create" class="btn btn-success">
                                <i class="fas fa-plus me-1"></i>Novo Projeto
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select name="filtroStatus" class="form-select">
                                <option value="">Todos os status</option>
                                <option value="Macro" selected="@(Model.FiltroStatus == "Macro")">Macro</option>
                                <option value="Planejamento" selected="@(Model.FiltroStatus == "Planejamento")">Planejamento</option>
                                <option value="Em Andamento" selected="@(Model.FiltroStatus == "Em Andamento")">Em Andamento</option>
                                <option value="Em Teste" selected="@(Model.FiltroStatus == "Em Teste")">Em Teste</option>
                                <option value="Concluído" selected="@(Model.FiltroStatus == "Concluído")">Concluído</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Responsável</label>
                            <input name="filtroResponsavel" value="@Model.FiltroResponsavel" class="form-control" placeholder="Nome do responsável">
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-search me-2">
                                <i class="fas fa-search me-1"></i>Buscar
                            </button>
                            <a href="/Projetos" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Limpar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @if (Model.Projetos.Any())
        {
            @foreach (var projeto in Model.Projetos)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold">@projeto.Nome</h6>
                            <span class="badge status-badge" style="background-color: @projeto.StatusCor">
                                @projeto.StatusNome
                            </span>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(projeto.Descricao))
                            {
                                <p class="text-muted small">@projeto.Descricao</p>
                            }

                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="border-end">
                                        <h6 class="text-primary mb-0">@projeto.TotalAtividades</h6>
                                        <small class="text-muted">Total</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border-end">
                                        <h6 class="text-success mb-0">@projeto.AtividadesConcluidas</h6>
                                        <small class="text-muted">Concluídas</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <h6 class="text-info mb-0">@projeto.ProgressoPercentual.ToString("F0")%</h6>
                                    <small class="text-muted">Progresso</small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-success"
                                         style="width: @projeto.ProgressoPercentual%"
                                         role="progressbar"></div>
                                </div>
                            </div>

                            <div class="small text-muted">
                                <div class="row">
                                    <div class="col-6">
                                        <i class="fas fa-calendar-start me-1"></i>
                                        <strong>Início:</strong> @projeto.DataInicio.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="col-6">
                                        @if (projeto.DataFimPrevista.HasValue)
                                        {
                                            <i class="fas fa-calendar-check me-1"></i>
                                            <strong>Previsto:</strong>
 
                                            @projeto.DataFimPrevista.Value.ToString("dd/MM/yyyy")
                                        }
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(projeto.ResponsavelNome))
                                {
                                    <div class="mt-2">
                                        <i class="fas fa-user me-1"></i>
                                        <strong>Responsável:</strong> @projeto.ResponsavelNome
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    @if (!string.IsNullOrEmpty(projeto.LinkProjeto))
                                    {
                                        <a href="@projeto.LinkProjeto" target="_blank" class="btn btn-outline-info btn-sm me-2">
                                            <i class="fas fa-external-link-alt me-1"></i>Link
                                        </a>
                                    }
                                    <a href="/Atividades?FiltroProjetoId=@projeto.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-tasks me-1"></i>Atividades
                                    </a>
                                </div>
                                <div>
                                    <a href="/Projetos/Edit/@projeto.Id" class="btn btn-outline-warning btn-sm" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger btn-sm" title="Excluir"
                                            onclick="confirmarExclusao(@projeto.Id, '@projeto.Nome')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="fas fa-project-diagram fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Nenhum projeto encontrado com os filtros aplicados.</p>
                    <a href="/Projetos/Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Criar primeiro projeto
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function confirmarExclusao(id, nome) {
            if (confirm(`Tem certeza que deseja excluir o projeto "${nome}"?\n\nEsta ação também excluirá todas as atividades relacionadas ao projeto.`)) {
                window.location.href = `/Projetos/Delete/${id}`;
            }
        }
    </script>
}
