@page
@model ProGestao.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="header-blue">
    <div class="container">
        <h2 class="mb-0">
            <i class="fas fa-chart-line me-2"></i>Dashboard - Gestão de Atividades
        </h2>
        <p class="text-white-50 mb-0 mt-2">Visão geral das métricas e performance da equipe</p>
    </div>
</div>

<div class="container">
    <!-- Cards de Métricas Principais -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <h5 class="card-title mb-1">Total de Atividades</h5>
                            <h2 class="mb-0">@Model.TotalAtividades</h2>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-tasks fa-2x opacity-75"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <a href="/Atividades" class="btn btn-light btn-sm">
                            <i class="fas fa-eye me-1"></i>Ver Todas
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card bg-warning text-white h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <h5 class="card-title mb-1">Em Andamento</h5>
                            <h2 class="mb-0">@Model.AtividadesAndamento</h2>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-play-circle fa-2x opacity-75"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <a href="/Atividades?status=andamento" class="btn btn-light btn-sm">
                            <i class="fas fa-filter me-1"></i>Filtrar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <h5 class="card-title mb-1">Pendentes</h5>
                            <h2 class="mb-0">@Model.AtividadesPendentes</h2>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x opacity-75"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <a href="/Atividades?status=pendentes" class="btn btn-light btn-sm">
                            <i class="fas fa-filter me-1"></i>Filtrar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <h5 class="card-title mb-1">Concluídas</h5>
                            <h2 class="mb-0">@Model.AtividadesConcluidas</h2>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x opacity-75"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <a href="/Atividades?status=concluidas" class="btn btn-light btn-sm">
                            <i class="fas fa-history me-1"></i>Histórico
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas e Métricas Importantes -->
    <div class="row mb-4">
        <div class="col-lg-4 mb-3">
            <div class="card border-danger h-100">
                <div class="card-header bg-danger text-white">
                    <h6 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Atividades Atrasadas
                    </h6>
                </div>
                <div class="card-body text-center">
                    <h1 class="text-danger mb-2">@Model.AtividadesAtrasadas</h1>
                    <p class="text-muted mb-3">Requerem atenção imediata</p>
                    @if (Model.AtividadesAtrasadas > 0)
                    {
                        <a href="/Atividades?status=atrasadas" class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-search me-1"></i>Ver Detalhes
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            <i class="fas fa-check me-1"></i>Tudo em dia!
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="card border-primary h-100">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">
                        <i class="fas fa-project-diagram me-2"></i>Projetos Ativos
                    </h6>
                </div>
                <div class="card-body text-center">
                    <h1 class="text-primary mb-2">@Model.ProjetosAtivos</h1>
                    <p class="text-muted mb-3">Em desenvolvimento</p>
                    <a href="/Projetos" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-cog me-1"></i>Gerenciar Projetos
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="card border-info h-100">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">
                        <i class="fas fa-users me-2"></i>Equipe Ativa
                    </h6>
                </div>
                <div class="card-body text-center">
                    <h1 class="text-info mb-2">@Model.UsuariosAtivos</h1>
                    <p class="text-muted mb-3">Desenvolvedores</p>
                    <a href="/Usuarios" class="btn btn-outline-info btn-sm">
                        <i class="fas fa-users-cog me-1"></i>Ver Equipe
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos e Relatórios -->
    <div class="row mb-4">
        <div class="col-lg-8 mb-3">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-chart-bar me-2"></i>Atividades por Status
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="statusChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-chart-pie me-2"></i>Distribuição por Prioridade
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="priorityChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Atividades Recentes e Próximos Vencimentos -->
    <div class="row mb-4">
        <div class="col-lg-6 mb-3">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-history me-2"></i>Atividades Recentes
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.AtividadesRecentes.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var atividade in Model.AtividadesRecentes.Take(5))
                            {
                                <div class="list-group-item border-0 px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">
                                                <a href="/Atividades/Details/@atividade.Id" class="text-decoration-none">
                                                    @atividade.Nome
                                                </a>
                                            </h6>
                                            <p class="mb-1 text-muted small">@atividade.ProjetoNome</p>
                                            <small class="text-muted">@atividade.UsuarioNome - @atividade.DataCriacao.ToString("dd/MM/yyyy")</small>
                                        </div>
                                        <span class="badge" style="background-color: @atividade.StatusCor">
                                            @atividade.StatusNome
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-center mt-3">
                            <a href="/Atividades" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-list me-1"></i>Ver Todas as Atividades
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">Nenhuma atividade encontrada</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-3">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>Próximos Vencimentos
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.ProximosVencimentos.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var atividade in Model.ProximosVencimentos.Take(5))
                            {
                                <div class="list-group-item border-0 px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">
                                                <a href="/Atividades/Details/@atividade.Id" class="text-decoration-none">
                                                    @atividade.Nome
                                                </a>
                                            </h6>
                                            <p class="mb-1 text-muted small">@atividade.ProjetoNome</p>
                                            <small class="text-muted">@atividade.UsuarioNome</small>
                                        </div>
                                        <div class="text-end">
                                            @{
                                                var diasRestantes = (atividade.DataFimPrevista!.Value.Date - DateTime.Today).Days;
                                                var corVencimento = diasRestantes < 0 ? "danger" : diasRestantes <= 2 ? "warning" : "success";
                                            }
                                            <span class="badge bg-@corVencimento">
                                                @if (diasRestantes < 0)
                                                {
                                                    <text>@Math.Abs(diasRestantes) dias atrasado</text>
                                                }
                                                else if (diasRestantes == 0)
                                                {
                                                    <text>Vence hoje</text>
                                                }
                                                else
                                                {
                                                    <text>@diasRestantes dias</text>
                                                }
                                            </span>
                                            <br>
                                            <small class="text-muted">@atividade.DataFimPrevista.Value.ToString("dd/MM/yyyy")</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-center mt-3">
                            <a href="/Atividades?filter=vencimentos" class="btn btn-outline-warning btn-sm">
                                <i class="fas fa-calendar me-1"></i>Ver Todos os Vencimentos
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center">
                            <i class="fas fa-calendar-check fa-2x text-success mb-2"></i>
                            <p class="text-muted">Nenhum vencimento próximo</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Performance da Equipe -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="fas fa-users-cog me-2"></i>Performance da Equipe
                        </h6>
                        <small class="text-muted">Últimos 30 dias</small>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.PerformanceEquipe.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Desenvolvedor</th>
                                        <th class="text-center">Total</th>
                                        <th class="text-center">Concluídas</th>
                                        <th class="text-center">Em Andamento</th>
                                        <th class="text-center">Atrasadas</th>
                                        <th class="text-center">Taxa Conclusão</th>
                                        <th>Progresso</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var performance in Model.PerformanceEquipe)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@performance.NomeUsuario</strong>
                                                @if (!string.IsNullOrEmpty(performance.Cargo))
                                                {
                                                    <br>
                                        
                                                    <small class="text-muted">@performance.Cargo</small>
                                                }
                                            </td>
                                            <td class="text-center">@performance.TotalAtividades</td>
                                            <td class="text-center">
                                                <span class="badge bg-success">@performance.AtividadesConcluidas</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-warning">@performance.AtividadesAndamento</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-danger">@performance.AtividadesAtrasadas</span>
                                            </td>
                                            <td class="text-center">
                                                <strong>@performance.TaxaConclusao.ToString("P0")</strong>
                                            </td>
                                            <td style="min-width: 150px;">
                                                <div class="progress" style="height: 20px;">
                                                    <td style="min-width: 150px;">  
                                                        <div class="progress" style="height: 20px;">  
                                                            <div class="progress-bar bg-success"  
                                                                 style="width: @(performance.TaxaConclusao * 100)%"  
                                                                 data-bs-toggle="tooltip"  
                                                                 title="@performance.TaxaConclusao.ToString("P0") taxa de conclusão">  
                                                                @if ((double)performance.TaxaConclusao > 0.1)  
                                                                {  
                                                                    <small>@performance.TaxaConclusao.ToString("P0")</small>  
                                                                }  
                                                            </div>  
                                                        </div>  
                                                    </td>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center">
                            <i class="fas fa-chart-line fa-2x text-muted mb-2"></i>
                            <p class="text-muted">Dados de performance não disponíveis</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Gráfico de Status
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'bar',
            data: {
                labels: ['Pendentes', 'Em Andamento', 'Concluídas', 'Canceladas'],
                datasets: [{
                    label: 'Atividades',
                    data: [@Model.AtividadesPendentes, @Model.AtividadesAndamento, @Model.AtividadesConcluidas, @Model.AtividadesCanceladas],
                    backgroundColor: [
                        'rgba(108, 117, 125, 0.8)',
                        'rgba(255, 193, 7, 0.8)',
                        'rgba(40, 167, 69, 0.8)',
                        'rgba(220, 53, 69, 0.8)'
                    ],
                    borderColor: [
                        'rgb(108, 117, 125)',
                        'rgb(255, 193, 7)',
                        'rgb(40, 167, 69)',
                        'rgb(220, 53, 69)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                },
                interaction: {
                    intersect: false,
                    mode: 'index'
                }
            }
        });

        // Gráfico de Prioridade
        const priorityCtx = document.getElementById('priorityChart').getContext('2d');
        new Chart(priorityCtx, {
            type: 'doughnut',
            data: {
                labels: ['Baixa', 'Normal', 'Alta', 'Crítica'],
                datasets: [{
                    data: [@Model.AtividadesPrioridadeBaixa, @Model.AtividadesPrioridadeNormal, @Model.AtividadesPrioridadeAlta, @Model.AtividadesPrioridadeCritica],
                    backgroundColor: [
                        'rgba(40, 167, 69, 0.8)',
                        'rgba(23, 162, 184, 0.8)',
                        'rgba(255, 193, 7, 0.8)',
                        'rgba(220, 53, 69, 0.8)'
                    ],
                    borderColor: [
                        'rgb(40, 167, 69)',
                        'rgb(23, 162, 184)',
                        'rgb(255, 193, 7)',
                        'rgb(220, 53, 69)'
                    ],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

         Auto-refresh a cada 5 minutos (opcional)
         setTimeout(function() {
             window.location.reload();
         }, 300000);
    </script>
}