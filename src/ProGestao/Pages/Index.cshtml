@page "/"
@model IndexModel
@{
    ViewData["Title"] = "ProGestao - Sistema de Gestão de Atividades";
}

<div class="header-blue">
    <div class="container text-center">
        <h1 class="display-4 mb-3">
            <i class="fas fa-tasks me-3"></i>ProGestao
        </h1>
        <p class="lead mb-0">Sistema de Gestão de Atividades para Equipes de Desenvolvimento</p>
    </div>
</div>

<div class="container">
    <div class="row mb-5">
        <!-- Card de Atividades -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card text-center h-100 shadow-sm border-0">
                <div class="card-body" style="display: flex; flex-direction: column;">
                    <div class="bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">
                        <i class="fas fa-tasks fa-2x"></i>
                    </div>
                    <h5 class="card-title">Gestão de Atividades</h5>
                    <p class="card-text" style="flex: 1;">Organize e acompanhe todas as atividades da sua equipe de desenvolvimento.</p>

                    <div class="btn-group" role="group" style="margin-top: auto;">
                        <a href="/Atividades" class="btn btn-primary">
                            <i class="fas fa-list me-1"></i>Acessar
                        </a>
                        <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Atividades"><i class="fas fa-list me-2"></i>Lista de Atividades</a></li>
                            <li><a class="dropdown-item" href="/Atividades/Create"><i class="fas fa-plus me-2"></i>Nova Atividade</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Atividades/Relatorios"><i class="fas fa-chart-bar me-2"></i>Relatórios</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card de Projetos -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card text-center h-100 shadow-sm border-0">
                <div class="card-body" style="display: flex; flex-direction: column;">
                    <div class="bg-success text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">
                        <i class="fas fa-project-diagram fa-2x"></i>
                    </div>
                    <h5 class="card-title">Projetos</h5>
                    <p class="card-text" style="flex: 1;">Gerencie seus projetos e acompanhe o progresso de cada um.</p>

                    <div class="btn-group" role="group" style="margin-top: auto;">
                        <a href="/Projetos" class="btn btn-success">
                            <i class="fas fa-folder me-1"></i>Acessar
                        </a>
                        <button type="button" class="btn btn-success dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Projetos"><i class="fas fa-folder me-2"></i>Lista de Projetos</a></li>
                            <li><a class="dropdown-item" href="/Projetos/Create"><i class="fas fa-folder-plus me-2"></i>Novo Projeto</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Timeline"><i class="fas fa-project-diagram me-2"></i>Timeline</a></li>
                            <li><a class="dropdown-item" href="/Grid"><i class="fas fa-th me-2"></i>Grid Semanal</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card de Equipe -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card text-center h-100 shadow-sm border-0">
                <div class="card-body" style="display: flex; flex-direction: column;">
                    <div class="bg-info text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                    <h5 class="card-title">Equipe</h5>
                    <p class="card-text" style="flex: 1;">Cadastre e gerencie os membros da sua equipe de desenvolvimento.</p>

                    <div class="btn-group" role="group" style="margin-top: auto;">
                        <a href="/Usuarios" class="btn btn-info">
                            <i class="fas fa-users me-1"></i>Acessar
                        </a>
                        <button type="button" class="btn btn-info dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Usuarios"><i class="fas fa-users me-2"></i>Lista da Equipe</a></li>
                            <li><a class="dropdown-item" href="/Usuarios/Create"><i class="fas fa-user-plus me-2"></i>Novo Membro</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Usuarios?filter=performance"><i class="fas fa-chart-line me-2"></i>Performance</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card de Dashboard -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card text-center h-100 shadow-sm border-0">
                <div class="card-body" style="display: flex; flex-direction: column;">
                    <div class="bg-warning text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">
                        <i class="fas fa-chart-line fa-2x"></i>
                    </div>
                    <h5 class="card-title">Dashboard</h5>
                    <p class="card-text" style="flex: 1;">Visualize métricas e relatórios de produtividade da equipe.</p>

                    <div class="btn-group" role="group" style="margin-top: auto;">
                        <a href="/Dashboard" class="btn btn-warning">
                            <i class="fas fa-chart-line me-1"></i>Acessar
                        </a>
                        <button type="button" class="btn btn-warning dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Dashboard"><i class="fas fa-chart-line me-2"></i>Métricas Gerais</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    <!-- Recursos do Sistema -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Recursos do Sistema
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="fas fa-check-circle text-success me-2"></i>Funcionalidades Principais</h6>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Criação e gestão de atividades</li>
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Controle de status e prioridades</li>
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Gestão de projetos e equipes</li>
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Dashboard com métricas em tempo real</li>
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Timeline e visualizações avançadas</li>
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Relatórios de produtividade</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-rocket text-primary me-2"></i>Próximas Funcionalidades</h6>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-arrow-right text-secondary me-2"></i>Sistema de autenticação</li>
                                <li><i class="fas fa-arrow-right text-secondary me-2"></i>Controle de permissões</li>
                                <li><i class="fas fa-arrow-right text-secondary me-2"></i>Timeline de projetos</li>
                                <li><i class="fas fa-arrow-right text-secondary me-2"></i>Notificações em tempo real</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>