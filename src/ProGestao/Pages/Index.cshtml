@page "/"
@model IndexModel
@{
    ViewData["Title"] = "ProGestao - Sistema de Gestão de Atividades";
}

<div class="header-blue">
    <div class="container text-center">
        <h1 class="display-4 mb-3">
            <i class="fas fa-tasks me-3"></i>ProGestao
        </h1>
        <p class="lead mb-0">Sistema de Gestão de Atividades para Equipes de Desenvolvimento</p>
    </div>
</div>

<div class="container">
    <div class="row mb-5">
        <!-- Card de Atividades com Submenu -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card text-center h-100 shadow-sm border-0 position-relative">
                <div class="card-body">
                    <div class="bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">
                        <i class="fas fa-tasks fa-2x"></i>
                    </div>
                    <h5 class="card-title">Gestão de Atividades</h5>
                    <p class="card-text">Organize e acompanhe todas as atividades da sua equipe de desenvolvimento.</p>

                    <!-- Botão principal com dropdown -->
                    <div class="btn-group" role="group">
                        <a href="/Atividades" class="btn btn-primary">
                            <i class="fas fa-list me-1"></i>Acessar
                        </a>
                        <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="/Atividades">
                                    <i class="fas fa-list me-2"></i>Lista de Atividades
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Atividades/Create">
                                    <i class="fas fa-plus me-2"></i>Nova Atividade
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <h6 class="dropdown-header">
                                    <i class="fas fa-eye me-1"></i>Visualizações
                                </h6>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Timeline">
                                    <i class="fas fa-project-diagram me-2"></i>Timeline
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Grid">
                                    <i class="fas fa-th me-2"></i>Grid Semanal
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Atividades/Kanban">
                                    <i class="fas fa-columns me-2"></i>Kanban
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card de Projetos -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card text-center h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="bg-success text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">
                        <i class="fas fa-project-diagram fa-2x"></i>
                    </div>
                    <h5 class="card-title">Projetos</h5>
                    <p class="card-text">Gerencie seus projetos e acompanhe o progresso de cada um.</p>

                    <div class="btn-group" role="group">
                        <a href="/Projetos" class="btn btn-success">
                            <i class="fas fa-folder me-1"></i>Acessar
                        </a>
                        <button type="button" class="btn btn-success dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="/Projetos">
                                    <i class="fas fa-folder me-2"></i>Lista de Projetos
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Projetos/Create">
                                    <i class="fas fa-plus me-2"></i>Novo Projeto
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="/Projetos?status=ativo">
                                    <i class="fas fa-play me-2"></i>Projetos Ativos
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Projetos?status=concluido">
                                    <i class="fas fa-check me-2"></i>Projetos Concluídos
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card de Equipe -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card text-center h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="bg-info text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                    <h5 class="card-title">Equipe</h5>
                    <p class="card-text">Cadastre e gerencie os membros da sua equipe de desenvolvimento.</p>

                    <div class="btn-group" role="group">
                        <a href="/Usuarios" class="btn btn-info">
                            <i class="fas fa-users me-1"></i>Acessar
                        </a>
                        <button type="button" class="btn btn-info dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="/Usuarios">
                                    <i class="fas fa-users me-2"></i>Lista da Equipe
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Usuarios/Create">
                                    <i class="fas fa-user-plus me-2"></i>Novo Membro
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="/Usuarios?filter=performance">
                                    <i class="fas fa-chart-line me-2"></i>Performance
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card de Dashboard -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card text-center h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="bg-warning text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">
                        <i class="fas fa-chart-line fa-2x"></i>
                    </div>
                    <h5 class="card-title">Dashboard</h5>
                    <p class="card-text">Visualize métricas e relatórios de produtividade da equipe.</p>

                    <div class="btn-group" role="group">
                        <a href="/Dashboard" class="btn btn-warning">
                            <i class="fas fa-chart-line me-1"></i>Acessar
                        </a>
                        <button type="button" class="btn btn-warning dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="/Dashboard">
                                    <i class="fas fa-tachometer-alt me-2"></i>Dashboard Principal
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="/Relatorios">
                                    <i class="fas fa-file-alt me-2"></i>Relatórios
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Dashboard/Performance">
                                    <i class="fas fa-users-cog me-2"></i>Performance da Equipe
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Seção de Acesso Rápido -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt me-2"></i>Acesso Rápido
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-2">
                            <a href="/Atividades/Create" class="btn btn-outline-primary btn-sm w-100">
                                <i class="fas fa-plus me-1"></i>Nova Atividade
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="/Projetos/Create" class="btn btn-outline-success btn-sm w-100">
                                <i class="fas fa-folder-plus me-1"></i>Novo Projeto
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="/Timeline" class="btn btn-outline-info btn-sm w-100">
                                <i class="fas fa-project-diagram me-1"></i>Timeline
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="/Grid" class="btn btn-outline-warning btn-sm w-100">
                                <i class="fas fa-th me-1"></i>Grid Semanal
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recursos do Sistema -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Recursos do Sistema
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="fas fa-check-circle text-success me-2"></i>Funcionalidades Principais</h6>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Criação e gestão de atividades</li>
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Controle de status e prioridades</li>
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Gestão de projetos e equipes</li>
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Dashboard com métricas em tempo real</li>
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Timeline e visualizações avançadas</li>
                                <li><i class="fas fa-arrow-right text-primary me-2"></i>Relatórios de produtividade</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-rocket text-warning me-2"></i>Próximas Funcionalidades</h6>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-clock text-muted me-2"></i>Cronograma visual (Gantt)</li>
                                <li><i class="fas fa-clock text-muted me-2"></i>Notificações por email</li>
                                <li><i class="fas fa-clock text-muted me-2"></i>Exportação de relatórios</li>
                                <li><i class="fas fa-clock text-muted me-2"></i>API REST para integrações</li>
                                <li><i class="fas fa-clock text-muted me-2"></i>Mobile app (PWA)</li>
                                <li><i class="fas fa-clock text-muted me-2"></i>Integração com Git/GitHub</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dropdown-menu {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.15);
    }

    .dropdown-header {
        font-size: 0.875rem;
        font-weight: 600;
        color: #6c757d;
    }

    .btn-group .dropdown-toggle-split {
        border-left: 1px solid rgba(255, 255, 255, 0.2);
    }

    .card:hover {
        transform: translateY(-2px);
        transition: transform 0.2s ease-in-out;
    }
</style>

@section Scripts {
    <script>
        // Adicionar efeitos visuais para os cards
        document.addEventListener('DOMContentLoaded', function() {
            // Efeito hover nos cards
            const cards = document.querySelectorAll('.card');
            cards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                    this.style.transition = 'transform 0.2s ease-in-out';
                });

                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });
        });
    </script>
}