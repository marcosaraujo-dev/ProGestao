@page
@model ProGestao.Pages.Timeline.IndexModel
@{
    ViewData["Title"] = "Timeline de Atividades";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/timeline.css" asp-append-version="true">


}


<div class="header-blue">
    <div class="container">
        <h2 class="mb-0">
            <i class="fas fa-timeline me-2"></i>Timeline de Atividades
        </h2>
    </div>
</div>

<div class="container">
    <!-- Filtros -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header card-header-blue">
                    <h5 class="mb-0">Filtros da Timeline</h5>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Período</label>
                            <select name="periodo" class="form-select">
                                <option value="7" selected="@(Model.PeriodoDias == 7)">Últimos 7 dias</option>
                                <option value="15" selected="@(Model.PeriodoDias == 15)">Últimos 15 dias</option>
                                <option value="30" selected="@(Model.PeriodoDias == 30)">Últimos 30 dias</option>
                                <option value="60" selected="@(Model.PeriodoDias == 60)">Últimos 60 dias</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Usuários</label>
                            <select name="usuarioIds" class="form-select" multiple>
                                @foreach (var usuario in Model.Usuarios)
                                {
                                    <option value="@usuario.Id"
                                            selected="@(Model.UsuariosSelecionados.Contains(usuario.Id))">
                                        @usuario.Nome
                                    </option>
                                }
                            </select>
                            <small class="text-muted">Ctrl+clique para múltipla seleção</small>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Projetos</label>
                            <select name="projetoIds" class="form-select" multiple>
                                @foreach (var projeto in Model.Projetos)
                                {
                                    <option value="@projeto.Id"
                                            selected="@(Model.ProjetosSelecionados.Contains(projeto.Id))">
                                        @projeto.Nome
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-search me-2">
                                <i class="fas fa-search me-1"></i>Filtrar
                            </button>
                            <a href="/Timeline" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Limpar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Timeline -->
    
    <!-- Controles de Visualização da Timeline -->
<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
                <i class="fas fa-clock me-2"></i>Timeline - @Model.AtividadesTimeline.Count() atividades encontradas
            </h6>
            
            <!-- Toggle de Visualização -->
            <div class="btn-group" role="group" aria-label="Opções de visualização">
                <input type="radio" class="btn-check" name="viewMode" id="view-timeline" value="timeline" checked>
                <label class="btn btn-outline-primary btn-sm" for="view-timeline" title="Timeline Vertical">
                    <i class="fas fa-timeline"></i>
                </label>

                <input type="radio" class="btn-check" name="viewMode" id="view-grid" value="grid">
                <label class="btn btn-outline-primary btn-sm" for="view-grid" title="Grid Compacto">
                    <i class="fas fa-th"></i>
                </label>

                <input type="radio" class="btn-check" name="viewMode" id="view-list" value="list">
                <label class="btn btn-outline-primary btn-sm" for="view-list" title="Lista Compacta">
                    <i class="fas fa-list"></i>
                </label>
            </div>
        </div>
    </div>
</div>

<!-- OPÇÃO 1: Timeline Vertical Compacta (Padrão) -->
<div id="timeline-view" class="timeline-container">
    <div class="timeline">
        @foreach (var grupo in Model.AtividadesTimeline.GroupBy(a => a.DataReferencia.Date).OrderByDescending(g => g.Key))
        {
            <div class="timeline-date">
                <i class="fas fa-calendar-day me-2"></i>
                @grupo.Key.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))
            </div>

            @foreach (var atividade in grupo.OrderByDescending(a => a.DataReferencia))
            {
                <div class="timeline-item">
                    <div class="timeline-marker timeline-marker-@atividade.TipoEvento.ToLower()">
                        @switch (atividade.TipoEvento.ToLower())
                        {
                            case "criacao": <i class="fas fa-plus"></i> break;
                            case "inicio": <i class="fas fa-play"></i> break;
                            case "conclusao": <i class="fas fa-check"></i> break;
                            case "atualizacao": <i class="fas fa-edit"></i> break;
                            default: <i class="fas fa-circle"></i> break;
                        }
                    </div>
                    
                    <div class="timeline-content">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h6 class="timeline-title mb-1">@atividade.AtividadeNome</h6>
                                <small class="timeline-project">
                                    <i class="fas fa-project-diagram me-1"></i>@atividade.ProjetoNome
                                </small>
                            </div>
                            <div class="text-end">
                                <span class="badge timeline-badge" style="background-color: @atividade.StatusCor">
                                    @atividade.StatusNome
                                </span>
                                <div class="timeline-time">@atividade.DataReferencia.ToString("HH:mm")</div>
                            </div>
                        </div>

                        <div class="timeline-details">
                            <div class="row">
                                <div class="col-md-6">
                                    <small><i class="fas fa-user me-1"></i><strong>Responsável:</strong> @atividade.UsuarioNome</small>
                                </div>
                                <div class="col-md-6">
                                    <small><i class="fas fa-tag me-1"></i><strong>Tipo:</strong> @atividade.TipoEvento</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- OPÇÃO 2: Grid Compacto (2 colunas em desktop) -->
<div id="grid-view" class="timeline-container" style="display: none;">
    @foreach (var grupo in Model.AtividadesTimeline.GroupBy(a => a.DataReferencia.Date).OrderByDescending(g => g.Key))
    {
        <div class="timeline-date mb-3">
            <i class="fas fa-calendar-day me-2"></i>
            @grupo.Key.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))
        </div>

        <div class="row mb-4">
            @foreach (var atividade in grupo.OrderByDescending(a => a.DataReferencia))
            {
                <div class="col-lg-6 col-md-12 mb-3">
                    <div class="card h-100 border-left-colored" style="border-left: 4px solid @atividade.StatusCor;">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-2">
                                <span class="timeline-marker timeline-marker-@atividade.TipoEvento.ToLower() position-static me-2">
                                    @switch (atividade.TipoEvento.ToLower())
                                    {
                                        case "criacao": <i class="fas fa-plus"></i> break;
                                        case "inicio": <i class="fas fa-play"></i> break;
                                        case "conclusao": <i class="fas fa-check"></i> break;
                                        case "atualizacao": <i class="fas fa-edit"></i> break;
                                        default: <i class="fas fa-circle"></i> break;
                                    }
                                </span>
                                <div class="flex-grow-1">
                                    <h6 class="card-title mb-1 text-truncate" title="@atividade.AtividadeNome">@atividade.AtividadeNome</h6>
                                    <small class="text-muted">
                                        <i class="fas fa-project-diagram me-1"></i>@atividade.ProjetoNome
                                    </small>
                                </div>
                                <div class="text-end">
                                    <span class="badge" style="background-color: @atividade.StatusCor; font-size: 0.7rem;">
                                        @atividade.StatusNome
                                    </span>
                                    <div style="font-size: 0.75rem; color: #6c757d;">@atividade.DataReferencia.ToString("HH:mm")</div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <small class="text-muted">
                                        <i class="fas fa-user me-1"></i>@atividade.UsuarioNome
                                    </small>
                                </div>
                                <div class="col-6 text-end">
                                    <small class="text-muted">
                                        <i class="fas fa-tag me-1"></i>@atividade.TipoEvento
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- OPÇÃO 3: Lista Ultra Compacta -->
<div id="list-view" class="timeline-container" style="display: none;">
    @foreach (var grupo in Model.AtividadesTimeline.GroupBy(a => a.DataReferencia.Date).OrderByDescending(g => g.Key))
    {
        <div class="timeline-date mb-2">
            <i class="fas fa-calendar-day me-2"></i>
            @grupo.Key.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))
        </div>

        <div class="list-group mb-4">
            @foreach (var atividade in grupo.OrderByDescending(a => a.DataReferencia))
            {
                <div class="list-group-item list-group-item-action d-flex align-items-center py-2">
                    <span class="timeline-marker timeline-marker-@atividade.TipoEvento.ToLower() position-static me-3" style="width: 20px; height: 20px;">
                        @switch (atividade.TipoEvento.ToLower())
                        {
                            case "criacao": <i class="fas fa-plus"></i> break;
                            case "inicio": <i class="fas fa-play"></i> break;
                            case "conclusao": <i class="fas fa-check"></i> break;
                            case "atualizacao": <i class="fas fa-edit"></i> break;
                            default: <i class="fas fa-circle"></i> break;
                        }
                    </span>
                    
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="d-block">@atividade.AtividadeNome</strong>
                                <small class="text-muted">
                                    <i class="fas fa-project-diagram me-1"></i>@atividade.ProjetoNome
                                    <span class="mx-2">•</span>
                                    <i class="fas fa-user me-1"></i>@atividade.UsuarioNome
                                </small>
                            </div>
                            <div class="text-end">
                                <span class="badge" style="background-color: @atividade.StatusCor; font-size: 0.7rem;">
                                    @atividade.StatusNome
                                </span>
                                <div style="font-size: 0.75rem; color: #6c757d;">@atividade.DataReferencia.ToString("HH:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

</div>
<script>
// JavaScript para alternar entre visualizações
document.addEventListener('DOMContentLoaded', function() {
    const viewButtons = document.querySelectorAll('input[name="viewMode"]');
    const containers = {
        'timeline': document.getElementById('timeline-view'),
        'grid': document.getElementById('grid-view'),
        'list': document.getElementById('list-view')
    };

    viewButtons.forEach(button => {
        button.addEventListener('change', function() {
            // Esconder todas as visualizações
            Object.values(containers).forEach(container => {
                if (container) container.style.display = 'none';
            });
            
            // Mostrar visualização selecionada
            const selectedContainer = containers[this.value];
            if (selectedContainer) {
                selectedContainer.style.display = 'block';
            }
            
            // Salvar preferência no localStorage
            localStorage.setItem('timeline-view-preference', this.value);
        });
    });

    // Carregar preferência salva
    const savedView = localStorage.getItem('timeline-view-preference') || 'timeline';
    const savedButton = document.getElementById(`view-${savedView}`);
    if (savedButton) {
        savedButton.checked = true;
        savedButton.dispatchEvent(new Event('change'));
    }
});
</script>

<style>
    .timeline {
        position: relative;
        padding: 0;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 30px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #dee2e6;
        }

    .timeline-date {
        margin-bottom: 2rem;
        padding-left: 70px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 2rem;
        padding-left: 70px;
    }

    .timeline-marker {
        position: absolute;
        left: 20px;
        top: 5px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 10px;
        z-index: 1;
    }

    .timeline-marker-criacao {
        background-color: #28a745;
    }

    .timeline-marker-inicio {
        background-color: #007bff;
    }

    .timeline-marker-conclusao {
        background-color: #17a2b8;
    }

    .timeline-marker-atualizacao {
        background-color: #ffc107;
    }

    .timeline-content {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .timeline-content:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
            transform: translateY(-2px);
            transition: all 0.3s ease;
        }

    .timeline-details {
        border-top: 1px solid #f8f9fa;
        margin-top: 0.5rem;
        padding-top: 0.5rem;
    }

    @@media (max-width: 768px) {
        .timeline::before

    {
        left: 15px;
    }

    .timeline-marker {
        left: 5px;
    }

    .timeline-item,
    .timeline-date {
        padding-left: 40px;
    }

    }
</style>
