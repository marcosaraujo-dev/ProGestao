@page
@model ProGestao.Pages.Usuarios.CreateModel
@{
    ViewData["Title"] = "Novo Usuário";
}

<div class="header-blue">
    <div class="container">
        <h2 class="mb-0">
            <i class="fas fa-user-plus me-2"></i>Novo Usuário
        </h2>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header card-header-blue">
                    <h5 class="mb-0">Informações do Usuário</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="Usuario.Nome" class="form-label">Nome Completo *</label>
                                <input asp-for="Usuario.Nome" class="form-control" placeholder="Digite o nome completo">
                                <span asp-validation-for="Usuario.Nome" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Usuario.Ativo" class="form-label">Status</label>
                                <select asp-for="Usuario.Ativo" class="form-select">
                                    <option value="true">Ativo</option>
                                    <option value="false">Inativo</option>
                                </select>
                                <span asp-validation-for="Usuario.Ativo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Usuario.Email" class="form-label">Email *</label>
                                <input asp-for="Usuario.Email" type="email" class="form-control"
                                       placeholder="usuario@empresa.com">
                                <span asp-validation-for="Usuario.Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Usuario.Cargo" class="form-label">Cargo *</label>
                                <input asp-for="Usuario.Cargo" class="form-control"
                                       placeholder="Ex: Desenvolvedor Sênior">
                                <span asp-validation-for="Usuario.Cargo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Usuario.EquipeId" class="form-label">Equipe *</label>
                                <select asp-for="Usuario.EquipeId" class="form-select">
                                    <option value="">Selecione uma equipe</option>
                                    @foreach (var equipe in Model.Equipes)
                                    {
                                        <option value="@equipe.Id">@equipe.Nome</option>
                                    }
                                </select>
                                <span asp-validation-for="Usuario.EquipeId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Usuario.DataAdmissao" class="form-label">Data de Admissão</label>
                                <input asp-for="Usuario.DataAdmissao" type="date" class="form-control">
                                <span asp-validation-for="Usuario.DataAdmissao" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Usuarios" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Voltar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>Salvar Usuário
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>