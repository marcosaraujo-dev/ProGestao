    @{
        // Função para verificar se a mensagem é válida
        bool IsMensagemValida(object mensagem)
        {
            return mensagem != null &&
            !string.IsNullOrWhiteSpace(mensagem.ToString()) &&
            mensagem.ToString().Trim().Length > 0;
        }

        var successMessage = TempData["SuccessMessage"];
        var errorMessage = TempData["ErrorMessage"];
        var warningMessage = TempData["WarningMessage"];
        var infoMessage = TempData["InfoMessage"];

        // Limpar mensagens processadas para não reaparecerem
        TempData.Remove("SuccessMessage");
        TempData.Remove("ErrorMessage");
        TempData.Remove("WarningMessage");
        TempData.Remove("InfoMessage");
    }

    @if (IsMensagemValida(successMessage))
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (IsMensagemValida(errorMessage))
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (IsMensagemValida(warningMessage))
    {
        <div class="container mt-3">
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>@warningMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (IsMensagemValida(infoMessage))
    {
        <div class="container mt-3">
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="fas fa-info-circle me-2"></i>@infoMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Conteúdo Principal -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <span class="text-light">&copy; 2024 - ProGestao - Sistema de Gestão de Atividades</span>
                </div>
                <div class="col-md-6 text-end">
                    <span class="text-light">Versão 1.0</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts obrigatórios -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script para auto-dismiss de alertas -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-dismiss alertas após 7 segundos (só sucesso e info)
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                // Verificar se é alerta de sucesso ou info (pode ser auto-dismissed)
                const isAutoDissmissable = alert.classList.contains('alert-success') ||
                                          alert.classList.contains('alert-info');

                if (isAutoDissmissable) {
                    // Auto-dismiss após 7 segundos apenas para sucessos e infos
                    setTimeout(function() {
                        if (alert && alert.parentNode && alert.classList.contains('show')) {
                            try {
                                const bsAlert = new bootstrap.Alert(alert);
                                bsAlert.close();
                            } catch (e) {
                                // Fallback: remover manualmente
                                alert.remove();
                            }
                        }
                    }, 7000);
                }
            });

            // Melhorar UX dos dropdowns
            const dropdowns = document.querySelectorAll('.dropdown-toggle');
            dropdowns.forEach(function(dropdown) {
                dropdown.addEventListener('show.bs.dropdown', function(e) {
                    // Garantir que o dropdown tenha z-index alto
                    const dropdownMenu = this.nextElementSibling;
                    if (dropdownMenu) {
                        dropdownMenu.style.zIndex = '1050';
                    }
                });

                dropdown.addEventListener('click', function(e) {
                    // Garantir que outros dropdowns fechem
                    const openDropdowns = document.querySelectorAll('.dropdown-menu.show');
                    openDropdowns.forEach(function(openDropdown) {
                        if (openDropdown !== dropdown.nextElementSibling) {
                            const bsDropdown = bootstrap.Dropdown.getInstance(openDropdown.previousElementSibling);
                            if (bsDropdown) {
                                bsDropdown.hide();
                            }
                        }
                    });
                });
            });

            // Adicionar animação suave para alertas
            const alertsWithAnimation = document.querySelectorAll('.alert');
            alertsWithAnimation.forEach(function(alert) {
                alert.addEventListener('closed.bs.alert', function() {
                    // Animação suave ao fechar
                    this.style.transition = 'opacity 0.3s ease-out';
                    this.style.opacity = '0';
                });
            });
        });
    </script>

    <!-- Scripts específicos das páginas -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>