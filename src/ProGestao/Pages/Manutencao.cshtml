@page
@model ManutencaoModel
@{
    ViewData["Title"] = "Funcionalidade em Manutenção";
}


<div class="header-blue">
    <div class="container">
        <h1 class="display-4 mb-3">
            <i class="fas fa-tasks me-3"></i>ProGestao
        </h1>
        <p class="lead mb-0">Página em Manutenção</p>
    </div>
</div>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg border-0 rounded-3 text-center">
                <div class="card-body p-5">

                    <div class="mb-4">
                        <i class="fas fa-tools fa-3x text-warning"></i>
                    </div>

                    <h2 class="fw-bold text-dark">Funcionalidade em Manutenção</h2>
                    <p class="text-muted mt-3">
                        Essa funcionalidade ainda não está liberada no sistema.<br />
                        Nossa equipe de desenvolvimento está trabalhando para disponibilizá-la em um futuro breve.
                    </p>

                    <a href="/" class="btn btn-primary mt-4 px-4">
                        <i class="fas fa-home me-2"></i> Voltar para a página inicial
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>
